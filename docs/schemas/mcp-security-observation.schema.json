{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://emo-cyber-agent/schemas/mcp-security-observation.schema.json",
  "title": "MCP security observation interop contract",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "kind", "statement", "evidence_ids"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "provenance": {
      "type": "object",
      "required": ["server_id", "protocol_version"],
      "properties": {
        "server_id": {"type": "string"},
        "protocol_version": {"type": "string"}
      }
    }
  }
}
