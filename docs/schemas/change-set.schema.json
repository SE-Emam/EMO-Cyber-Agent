{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://emo-cyber-agent/schemas/change-set.schema.json",
  "title": "ChangeSet interop contract",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["audit_id", "base_snapshot_id", "target_snapshot_id", "files", "change_digest"],
  "properties": {
    "audit_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string"},
    "base_snapshot_id": {"type": "string", "minLength": 1},
    "target_snapshot_id": {"type": "string", "minLength": 1},
    "base_revision": {"type": "string"},
    "target_revision": {"type": "string"},
    "created_at": {"type": "string"},
    "source_provenance": {"type": "string"},
    "symbols": {"type": "array", "items": {"type": "object"}},
    "routes": {"type": "array", "items": {"type": "object"}},
    "dependencies": {"type": "array", "items": {"type": "object"}},
    "database_relations": {"type": "array", "items": {"type": "object"}},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "state"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "previous_path": {"type": "string"},
          "state": {"type": "string", "enum": ["ADDED", "REMOVED", "MODIFIED", "RENAMED", "MOVED", "UNCHANGED", "UNKNOWN"]},
          "generated": {"type": "boolean"},
          "regions": {"type": "array", "items": {"type": "object"}},
          "classifications": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "classifications": {"type": "array", "items": {"type": "object"}},
    "coverage": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "change_digest": {"type": "string", "minLength": 1}
  }
}
