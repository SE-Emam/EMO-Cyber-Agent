{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/emo-cyber-agent/schemas/finding.schema.json",
  "title": "EMO Cyber Finding",
  "type": "object",
  "required": ["title", "severity", "confidence", "description", "impact", "evidence_ids", "remediation"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["suspected", "supported", "confirmed", "refuted", "accepted_risk", "not_reproducible"]},
    "asset_id": {"type": ["string", "null"]},
    "taxonomy": {"type": "object"},
    "description": {"type": "string", "minLength": 1},
    "impact": {"type": "string", "minLength": 1},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verification": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["finding_id", "method"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "finding_id": {"type": "string", "minLength": 1},
            "status": {"enum": ["pending", "in_progress", "verified", "refuted", "unresolved"]},
            "method": {"type": "string", "minLength": 1},
            "environment": {"type": "string", "minLength": 1},
            "evidence_ids": {"type": "array", "items": {"type": "string"}},
            "timestamp": {"type": "string", "format": "date-time"},
            "residual_uncertainty": {"type": "string"}
          },
          "additionalProperties": false
        }
      ]
    },
    "remediation": {"type": "string", "minLength": 1},
    "references": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
