{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/emo-cyber-agent/schemas/task.schema.json",
  "title": "EMO Cyber Task Template",
  "description": "Export/authoring contract for TaskSpec. Domain model is the source of truth; this schema validates the serialized form. task schema version 1.0.",
  "type": "object",
  "required": ["task_id", "name", "version", "objective", "acceptance_criteria"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9\\-]{1,78}[a-z0-9]$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "type": {"enum": ["audit", "review", "verification_support", "threat_model"]},
    "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
    "scope": {
      "type": "object",
      "properties": {
        "included": {"type": "array", "items": {"type": "string"}},
        "excluded": {"type": "array", "items": {"type": "string"}},
        "target_types": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "inputs_required": {"type": "array", "items": {"type": "string"}},
    "inputs_optional": {"type": "array", "items": {"type": "string"}},
    "required_skills": {"type": "array", "items": {"type": "string"}},
    "optional_skills": {"type": "array", "items": {"type": "string"}},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "denied_capabilities": {"type": "array", "items": {"type": "string"}},
    "required_tools": {"type": "array", "items": {"type": "string"}},
    "optional_tools": {"type": "array", "items": {"type": "string"}},
    "methodology_phases": {"type": "array", "items": {"type": "string"}},
    "methodology_procedures": {"type": "array", "items": {"type": "string"}},
    "evidence_required": {"type": "array", "items": {"type": "string"}},
    "evidence_provenance_required": {"type": "boolean"},
    "evidence_minimum_quality": {"type": "string"},
    "verification_required": {"type": "boolean"},
    "verification_methods": {"type": "array", "items": {"type": "string"}},
    "verification_confirmation": {"type": "string"},
    "verification_refutation": {"type": "string"},
    "verification_stop_conditions": {"type": "array", "items": {"type": "string"}},
    "security_read_only_default": {"type": "boolean"},
    "security_forbidden_actions": {"type": "array", "items": {"type": "string"}},
    "security_external_targets": {"type": "string"},
    "security_secrets_policy": {"type": "string"},
    "security_untrusted_content": {"type": "string"},
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "deliverables": {"type": "array", "items": {"type": "string"}},
    "report_template": {"type": "string"},
    "report_required_sections": {"type": "array", "items": {"type": "string"}},
    "extends": {"type": ["string", "null"]},
    "provenance": {"type": "object"}
  },
  "additionalProperties": false
}
