{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://emo-cyber-agent/schemas/security-skill-pack.schema.json",
  "title": "SecuritySkillPack flat contract",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack_id", "name", "version", "purpose", "skills", "checks"],
  "properties": {
    "pack_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9\\-]{1,78}[a-z0-9]$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 1000},
    "skills": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_code_intelligence": {"type": "array", "items": {"type": "string"}},
    "required_evidence": {"type": "array", "items": {"type": "string"}},
    "required_verification": {"type": "array", "items": {"type": "string"}},
    "applicable_assets": {"type": "array", "items": {"type": "string"}},
    "security_domains": {"type": "array", "items": {"type": "string"}},
    "methodology": {"type": "array", "items": {"type": "string"}},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "title", "methodology", "evidence_required", "hypothesis_template"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9\\-]{1,78}[a-z0-9]$"},
          "title": {"type": "string", "minLength": 1},
          "methodology": {"type": "array", "items": {"type": "string"}},
          "evidence_required": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence_sufficient": {"type": "array", "items": {"type": "string"}},
          "evidence_missing": {"type": "array", "items": {"type": "string"}},
          "verification_required": {"type": "array", "items": {"type": "string"}},
          "verification_safety": {"type": "string"},
          "high_risk": {"type": "boolean"},
          "entry_level": {"type": "string", "enum": ["OBSERVED", "SUSPECTED", "HYPOTHESIS", "VERIFICATION_REQUIRED"]},
          "codeintel_needs": {"type": "array", "items": {"type": "string"}},
          "source_kinds": {"type": "array", "items": {"type": "string"}},
          "sink_kinds": {"type": "array", "items": {"type": "string"}},
          "hypothesis_template": {"type": "string"}
        }
      }
    },
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "denied_capabilities": {"type": "array", "items": {"type": "string"}},
    "allowed_tools": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object"}
  }
}
