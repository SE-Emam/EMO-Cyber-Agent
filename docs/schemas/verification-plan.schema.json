{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://emo-cyber-agent/schemas/verification-plan.schema.json",
  "title": "Verification strategy plan interop contract",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_id", "project_id", "snapshot_id", "hypothesis_kind", "target",
    "strategy_id", "strategy_version", "strategy_digest", "oracle", "safety_level",
    "core_capability", "success_criteria", "refutation_criteria",
    "policy_decision_id", "policy_version"
  ],
  "properties": {
    "plan_id": {"type": "string", "maxLength": 120},
    "audit_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "hypothesis_kind": {
      "enum": [
        "AUTHORIZATION", "OBJECT_AUTHORIZATION", "FUNCTION_AUTHORIZATION",
        "AUTHENTICATION", "INPUT_VALIDATION", "INJECTION", "DATA_FLOW", "SSRF",
        "PATH_TRAVERSAL", "SECRET_EXPOSURE", "OUTPUT_ENCODING", "CONFIGURATION",
        "DEPENDENCY", "MCP_SCOPE", "MCP_OUTPUT_ISOLATION", "AGENT_DELEGATION",
        "AGENT_CONTEXT", "REGRESSION", "STATE_CHANGE", "NETWORK_BEHAVIOR"
      ]
    },
    "statement": {"type": "string", "maxLength": 1000},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "object_identity", "audit_id", "project_id", "snapshot_id"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 60},
        "object_identity": {"type": "string", "minLength": 1, "maxLength": 400},
        "audit_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "locator": {"type": "string", "maxLength": 400},
        "path_parameter": {"type": "string", "maxLength": 200},
        "query_parameter": {"type": "string", "maxLength": 200},
        "body_reference": {"type": "string", "maxLength": 200},
        "provenance": {"type": "object"}
      }
    },
    "strategy_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "strategy_version": {"type": "string", "minLength": 1, "maxLength": 40},
    "strategy_digest": {"type": "string", "minLength": 1, "maxLength": 128},
    "strategy_category": {"type": "string", "maxLength": 60},
    "adapter_id": {"type": "string", "maxLength": 80},
    "adapter_version": {"type": "string", "maxLength": 40},
    "adapter_contract_version": {"type": "string", "maxLength": 40},
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject", "operator"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 60},
        "subject": {"type": "string", "minLength": 1, "maxLength": 200},
        "operator": {
          "enum": ["EQUALS", "NOT_EQUALS", "CONTAINS", "NOT_CONTAINS", "EXISTS", "NOT_EXISTS", "IN_SET", "ABSENT_FROM_SET"]
        },
        "expected": {"type": "string", "maxLength": 500},
        "assertion": {"type": "string", "maxLength": 80}
      }
    },
    "safety_level": {"enum": ["PASSIVE", "SAFE_ACTIVE", "RESTRICTED_ACTIVE"]},
    "required_capabilities": {"type": "array", "items": {"type": "string", "maxLength": 60}},
    "core_capability": {
      "enum": ["verification.static", "verification.config", "verification.read_query", "verification.controlled_reproduction"]
    },
    "resource_budget": {"type": "object"},
    "success_criteria": {"type": "string", "minLength": 1, "maxLength": 500},
    "refutation_criteria": {"type": "string", "minLength": 1, "maxLength": 500},
    "available_evidence": {"type": "array", "items": {"type": "string", "maxLength": 80}},
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "positive_control": {"enum": ["PRESENT", "ABSENT", "NOT_APPLICABLE"]},
        "negative_control": {"enum": ["PRESENT", "ABSENT", "NOT_APPLICABLE"]},
        "rationale": {"type": "string", "maxLength": 300}
      }
    },
    "policy_decision_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 60},
    "selection_notes": {"type": "array", "items": {"type": "string", "maxLength": 200}},
    "limitations": {"type": "array", "items": {"type": "string", "maxLength": 200}},
    "digest": {"type": "string", "maxLength": 128}
  }
}
