{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://emo-cyber-agent/schemas/verification-result.schema.json",
  "title": "Verification strategy result interop contract",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_id",
    "plan_id",
    "audit_id",
    "project_id",
    "snapshot_id",
    "status",
    "operational_result",
    "coverage"
  ],
  "properties": {
    "verification_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "audit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "enum": [
        "SUPPORTED",
        "REFUTED",
        "INCONCLUSIVE",
        "NOT_RUN",
        "BLOCKED"
      ]
    },
    "operational_result": {
      "enum": [
        "OK",
        "TARGET_UNAVAILABLE",
        "TIMEOUT",
        "AUTH_UNAVAILABLE",
        "NETWORK_DENIED",
        "FIXTURE_MISSING",
        "TOOL_MISSING",
        "ENV_MISCONFIGURED",
        "RESOURCE_LIMITED",
        "POLICY_DENIED",
        "MALFORMED_OUTPUT",
        "TARGET_CHANGED",
        "VERSION_MISMATCH"
      ]
    },
    "oracle_outcome": {
      "enum": [
        "",
        "SUPPORTED",
        "REFUTED",
        "INCONCLUSIVE"
      ]
    },
    "oracle_reason": {
      "type": "string",
      "maxLength": 80
    },
    "coverage": {
      "$ref": "#/definitions/coverage"
    },
    "evidence_id": {
      "type": "string",
      "maxLength": 128
    },
    "provenance": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "data_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      }
    },
    "retry_class": {
      "enum": [
        "NONE",
        "OPERATIONAL_RETRY",
        "SECURITY_RETRY"
      ]
    },
    "digest": {
      "type": "string",
      "maxLength": 128
    }
  },
  "definitions": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "controls",
        "conclusion_ceiling"
      ],
      "properties": {
        "coverage": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "LIMITED",
            "UNKNOWN"
          ]
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "positive_control": {
              "enum": [
                "PRESENT",
                "ABSENT",
                "NOT_APPLICABLE"
              ]
            },
            "negative_control": {
              "enum": [
                "PRESENT",
                "ABSENT",
                "NOT_APPLICABLE"
              ]
            },
            "rationale": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "conclusion_ceiling": {
          "const": "context-only"
        },
        "digest": {
          "type": "string",
          "maxLength": 128
        }
      }
    }
  }
}
