{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/emo-cyber-agent/schemas/report-template.schema.json",
  "title": "EMO Cyber Report Template",
  "description": "Authoring/export contract for ReportTemplateSpec. Domain model is the source of truth; this schema validates the serialized form. template schema version 1.0.",
  "type": "object",
  "required": ["template_id", "name", "version"],
  "properties": {
    "template_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9\\-]{1,78}[a-z0-9]$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "type": {"type": "string"},
    "description": {"type": "string", "maxLength": 1000},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 60},
          "fields": {"type": "array", "items": {"type": "string"}},
          "visibility": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["show_if_field", "operator"],
              "properties": {
                "show_if_field": {"type": "string"},
                "operator": {"enum": ["==", "!=", "in", "not-in"]},
                "value": {}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "finding_fields": {"type": "array", "items": {"type": "string"}},
    "section_order": {"type": "array", "items": {"type": "string"}},
    "show_non_reportable": {"type": "boolean"},
    "evidence_presentation": {"type": "string"},
    "verification_presentation": {"type": "string"},
    "limitations_sections": {"type": "array", "items": {"type": "string"}},
    "appendices": {"type": "array", "items": {"type": "string"}},
    "output_formats": {"type": "array", "minItems": 1, "items": {"enum": ["json", "jsonl", "markdown"]}},
    "extends": {"type": ["string", "null"]},
    "preserve_provenance": {"type": "boolean"},
    "redact_secrets": {"type": "boolean"},
    "deterministic": {"type": "boolean"},
    "provenance": {"type": "object"}
  },
  "additionalProperties": false
}
