{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://emo-cyber-agent/schemas/code-intelligence.schema.json",
  "title": "Code intelligence snapshot/observation/provenance interop contract",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "snapshot", "observations", "query_provenance"],
  "properties": {
    "contract_version": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_id", "provider", "provider_version", "source_digest"],
      "properties": {
        "audit_id": {"type": "string", "minLength": 1},
        "asset_id": {"type": "string"},
        "provider": {"type": "string", "minLength": 1},
        "provider_version": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"]},
        "source_digest": {"type": "string"},
        "limitation": {"type": "string"}
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "kind", "statement", "evidence_ids"],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["DATAFLOW_PATH_FOUND", "UNRESOLVED_AUTH_BOUNDARY", "DATABASE_ACCESS_PATH", "EXTERNAL_CALL_PATH", "DEPENDENCY_USAGE", "ROUTE_HANDLER_DISCOVERED", "STATE_CHANGE_OPERATION"]},
          "statement": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "query_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_type", "provider", "snapshot_digest", "result_digest"],
        "properties": {
          "query_type": {"type": "string", "minLength": 1},
          "target": {"type": "string"},
          "provider": {"type": "string", "minLength": 1},
          "provider_version": {"type": "string"},
          "snapshot_digest": {"type": "string"},
          "timestamp": {"type": "string"},
          "result_digest": {"type": "string"}
        }
      }
    }
  }
}
